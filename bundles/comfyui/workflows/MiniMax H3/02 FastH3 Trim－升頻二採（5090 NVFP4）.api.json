{
  "source": {
    "class_type": "LoadImage",
    "inputs": {
      "image": ""
    }
  },
  "model": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "fastvideo_fasth3_trim_8step_nvfp4.safetensors",
      "weight_dtype": "default"
    }
  },
  "video_vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_video_vae_int8_convrot.safetensors"
    }
  },
  "audio_vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
    }
  },
  "clip": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "type": "minimax",
      "device": "default"
    }
  },
  "shift": {
    "class_type": "MiniMaxH3SigmaShift",
    "inputs": {
      "model": [
        "model",
        0
      ],
      "shift_video": 12,
      "shift_audio": 3
    }
  },
  "attention": {
    "class_type": "ModelAttentionBackend",
    "inputs": {
      "model": [
        "shift",
        0
      ],
      "attention": "comfy kitchen attention"
    }
  },
  "sparse": {
    "class_type": "BlockSparseAttention",
    "inputs": {
      "model": [
        "attention",
        0
      ],
      "selection": "vsa",
      "selection.keep_percent": 10,
      "start_percent": 0.2,
      "end_percent": 1,
      "dense_blocks": "",
      "min_tokens": 12288,
      "extra_tokens": 256,
      "sink_conditioning": "exact_kv_and_rows",
      "verbose": false
    }
  },
  "encode": {
    "class_type": "MiniMaxH3ImageToVideo",
    "inputs": {
      "clip": [
        "clip",
        0
      ],
      "vae": [
        "video_vae",
        0
      ],
      "first_frame": [
        "source",
        0
      ],
      "prompt": "The subject gently sways their body. The camera slowly moves closer and settles on an upper-body framing, preserving the person's appearance and the original scene with smooth, natural motion.",
      "width": [
        "resolution",
        0
      ],
      "height": [
        "resolution",
        1
      ],
      "length": 124
    }
  },
  "guider": {
    "class_type": "BasicGuider",
    "inputs": {
      "model": [
        "sparse",
        0
      ],
      "conditioning": [
        "encode",
        0
      ]
    }
  },
  "noise": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": 0
    }
  },
  "sampler": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "euler"
    }
  },
  "schedule": {
    "class_type": "BasicScheduler",
    "inputs": {
      "model": [
        "model",
        0
      ],
      "scheduler": "simple",
      "steps": 8,
      "denoise": 1
    }
  },
  "sample": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": [
        "noise",
        0
      ],
      "guider": [
        "guider",
        0
      ],
      "sampler": [
        "sampler",
        0
      ],
      "sigmas": [
        "sigmas_first",
        0
      ],
      "latent_image": [
        "encode",
        1
      ]
    }
  },
  "decode": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "sample_refine",
        0
      ],
      "vae": [
        "video_vae",
        0
      ]
    }
  },
  "decode_audio": {
    "class_type": "VAEDecodeAudio",
    "inputs": {
      "samples": [
        "sample_refine",
        0
      ],
      "vae": [
        "audio_vae",
        0
      ]
    }
  },
  "trim_frames": {
    "class_type": "ImageFromBatch",
    "inputs": {
      "image": [
        "decode",
        0
      ],
      "batch_index": 0,
      "length": 120
    }
  },
  "trim_audio": {
    "class_type": "TrimAudioDuration",
    "inputs": {
      "audio": [
        "decode_audio",
        0
      ],
      "start_index": 0,
      "duration": 5
    }
  },
  "combine": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "trim_frames",
        0
      ],
      "audio": [
        "trim_audio",
        0
      ],
      "fps": 24,
      "codec": "none",
      "color_space": "sRGB",
      "bit_depth": "auto"
    }
  },
  "save": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "combine",
        0
      ],
      "filename_prefix": "PhotoCreate/_videos/preview/clip",
      "format": "mp4",
      "format.codec": "h264",
      "format.codec.encoding": "auto"
    }
  },
  "resolution": {
    "class_type": "ResolutionSelector",
    "inputs": {
      "aspect_ratio": "16:9 (Widescreen)",
      "megapixels": 0.4,
      "multiple": 32
    }
  },
  "sigmas_first": {
    "class_type": "SplitSigmas",
    "inputs": {
      "sigmas": [
        "schedule",
        0
      ],
      "step": 4
    }
  },
  "separate": {
    "class_type": "LTXVSeparateAVLatent",
    "inputs": {
      "av_latent": [
        "sample",
        1
      ]
    }
  },
  "resolution_high": {
    "class_type": "ResolutionSelector",
    "inputs": {
      "aspect_ratio": "16:9 (Widescreen)",
      "megapixels": 1,
      "multiple": 32
    }
  },
  "encode_high": {
    "class_type": "MiniMaxH3ImageToVideo",
    "inputs": {
      "clip": [
        "clip",
        0
      ],
      "vae": [
        "video_vae",
        0
      ],
      "first_frame": [
        "source",
        0
      ],
      "prompt": "The subject gently sways their body. The camera slowly moves closer and settles on an upper-body framing, preserving the person's appearance and the original scene with smooth, natural motion.",
      "width": [
        "resolution_high",
        0
      ],
      "height": [
        "resolution_high",
        1
      ],
      "length": 124
    }
  },
  "upscale": {
    "class_type": "MinimaxH3LatentUpscaler3D",
    "inputs": {
      "latent": [
        "separate",
        0
      ],
      "model_name": "minimax_h3_latent_upscaler_3d_conv_v1_fp16.safetensors",
      "mode": "target dimensions",
      "mode.width": [
        "resolution_high",
        0
      ],
      "mode.height": [
        "resolution_high",
        1
      ],
      "align": 32,
      "enable_temporal_chunking": true,
      "force_unload": true,
      "device": "cuda",
      "precision": "fp16"
    }
  },
  "concat": {
    "class_type": "LTXVConcatAVLatent",
    "inputs": {
      "video_latent": [
        "upscale",
        0
      ],
      "audio_latent": [
        "separate",
        1
      ]
    }
  },
  "guider_high": {
    "class_type": "BasicGuider",
    "inputs": {
      "model": [
        "sparse",
        0
      ],
      "conditioning": [
        "encode_high",
        0
      ]
    }
  },
  "sigmas_refine": {
    "class_type": "ManualSigmas",
    "inputs": {
      "sigmas": "0.9035, 0.6316, 0.3158, 0.0000"
    }
  },
  "sample_refine": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": [
        "noise",
        0
      ],
      "guider": [
        "guider_high",
        0
      ],
      "sampler": [
        "sampler",
        0
      ],
      "sigmas": [
        "sigmas_refine",
        0
      ],
      "latent_image": [
        "concat",
        0
      ]
    }
  }
}
